
# =================== APP ===================
PROJECT_NAME="Prumo API"
DEBUG=true
API_V1_PREFIX="/api/v1"

# =================== CORS ===================
# Comma-separated list of allowed origins.
# With DEBUG=true any http://localhost:<port> / http://127.0.0.1:<port>
# origin is also accepted, so a git worktree serving Vite on a
# non-default port needs no edit here. Outside DEBUG this list is the
# only gate.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080"

# Public origin of the web app; links in agent (MCP) results point here.
PUBLIC_APP_URL=http://localhost:8080

# Public origin of this API; setting it turns OAuth for /mcp on (unset = off).
# PUBLIC_API_URL=http://localhost:8000

# Comma-separated OAuth redirect URIs a /mcp client may register (exact match);
# loopback http URIs are always allowed.
MCP_OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback

# =================== SUPABASE ===================
SUPABASE_ENV="local"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# =================== DATABASE ===================
# Connection string do Postgres (Supabase ou local)
DATABASE_URL="postgresql://postgres:password@localhost:54322/postgres"
# Para migrations remotas no Supabase, prefira o pooler com SSL:
# DATABASE_URL="postgresql://postgres.<project_ref>:<db_password>@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"
# Evite hosts no formato db.<project_ref>.supabase.co quando houver falha de DNS no ambiente local.

# =================== OPENAI ===================
OPENAI_API_KEY="sk-your-openai-api-key"
# LLM_DEFAULT_MODEL — code default is gpt-5.6-luna; see app/core/config.py
# Optional operator key; when empty, Claude models are BYOK-only in this deployment.
ANTHROPIC_API_KEY=""
# Optional operator key; when empty, Gemini models are BYOK-only in this deployment.
GOOGLE_API_KEY=""
# Optional operator key (https://ollama.com/settings/keys); when empty, Ollama Cloud models are BYOK-only.
OLLAMA_API_KEY=""

# =================== RATE LIMITING ===================
RATE_LIMIT_PER_MINUTE=60

# =================== SECURITY ===================
# Root of every per-user and per-row key (Zotero credentials, LLM connections,
# AI-run plan tokens). The web service and the worker refuse to boot with this
# placeholder or a blank value unless SUPABASE_ENV=local. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never rotate a deployed key: values encrypted under the old key become unreadable.
ENCRYPTION_KEY="review_hub_default_key_change_me_in_production"

# =================== LOGFIRE LLM OBSERVABILITY (OPTIONAL) ===================
# Logfire LLM observability (optional — fully inert when unset)
# LOGFIRE_TOKEN=
